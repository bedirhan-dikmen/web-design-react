# Copy to .env on the server:   cp .env.example .env
# .env is git-ignored — never commit the real token.

# Host port the site listens on inside your network (http://<server-ip>:3080).
# Pick a port no other site on the server uses.
WEB_PORT=3080

# Timezone for server logs.
TZ=Europe/Istanbul

# ---- Cloudflare Tunnel ------------------------------------------------------
# Enables the cloudflared container. Remove this line (or leave it empty) to
# run the site without the tunnel.
COMPOSE_PROFILES=tunnel

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > token.
# It is the long string after "--token" in the install command Cloudflare shows.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Contact form (optional) -------------------------------------------------
# JSON POST endpoint for the contact form. Empty = the form tells visitors that
# online sending is not active yet and offers e-mail/phone instead.
# Build-time value: after changing it, rebuild with  docker compose up -d --build
NEXT_PUBLIC_CONTACT_ENDPOINT=
